{
  "appId": "local.llm-wiki.desktop",
  "productName": "LLM Wiki",
  "directories": {
    "output": "release"
  },
  "files": ["out/**/*", "package.json"],
  "asar": true,
  "npmRebuild": false,
  "publish": {
    "provider": "github",
    "owner": "Jong-Yu",
    "repo": "llm-wiki-releases",
    "releaseType": "release"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "artifactName": "${productName}-${version}.${ext}",
    "icon": "design/brand/llm-wiki-icon.icns",
    "identity": null,
    "category": "public.app-category.productivity"
  },
  "win": {
    "target": ["nsis"],
    "icon": "design/brand/llm-wiki-icon.ico",
    "signExecutable": false
  },
  "linux": {
    "target": "tar.gz",
    "icon": "design/brand/llm-wiki-icon.png",
    "category": "Office"
  },
  "dmg": {
    "title": "LLM Wiki ${version}",
    "contents": [
      {
        "x": 130,
        "y": 180
      },
      {
        "x": 410,
        "y": 180,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  }
}
