{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "paths": {
      "@contracts/*": ["../../src/shared/contracts/*"],
      "@renderer/*": ["../../src/renderer/*"]
    }
  },
  "include": [
    "../../src/renderer/**/*.ts",
    "../../src/renderer/**/*.tsx",
    "../../src/shared/contracts/**/*.ts"
  ]
}
