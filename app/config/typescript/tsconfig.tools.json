{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "paths": {
      "@contracts/*": ["../../src/shared/contracts/*"],
      "@renderer/*": ["../../src/renderer/*"],
      "@main/*": ["../../src/main/*"]
    }
  },
  "include": [
    "../*.config.ts",
    "../../src/renderer/env.d.ts",
    "../../src/main/env.d.ts",
    "../../tests/poc-ui/verify.ts",
    "../../tests/ontology-cleanup/verify.ts",
    "../../tests/ontology-review/verify.ts"
  ]
}
